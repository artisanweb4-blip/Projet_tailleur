+{% extends "base.html" %}
+{% load static %}
+{% load trad %}
+
+{% block title %}Abonnement expiré — {{ atelier.nom }}{% endblock %}
+
+{% block content %}
+<div class="row justify-content-center">
+    <div class="col-lg-7 col-xl-6">
+        <div class="card border-0 shadow-sm mt-4">
+            <div class="card-body p-4 p-md-5 text-center">
+                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
+                     style="width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,var(--primary-color),var(--accent-color));">
+                    <i class="bi bi-clock-history text-white" style="font-size:1.7rem;"></i>
+                </div>
+                <h4 class="fw-bold mb-2">{% tr "Boutique suspendue" %}</h4>
+                <p class="text-muted mb-4">
+                    {% if infos and infos.statut == 'SANS_ABONNEMENT' %}
+                        {% tr "Aucun abonnement n'est actif pour cette boutique." %}
+                    {% else %}
+                        {% tr "L'abonnement de cette boutique a expiré le" %}
+                        <strong>{{ infos.date_fin|date:"d/m/Y" }}</strong>.
+                    {% endif %}
+                    <br>
+                    {% tr "Vos données sont conservées en sécurité jusqu'au" %}
+                    <strong>{{ infos.echeance|date:"d/m/Y" }}</strong>
+                    {% if infos and infos.jours_restants > 0 %}
+                        ({% tr "encore" %} {{ infos.jours_restants }} {% tr "jours" %}).
+                    {% else %}
+                        .
+                    {% endif %}
+                </p>
+                <div class="alert alert-light border small text-start">
+                    <i class="bi bi-info-circle me-1 text-primary"></i>
+                    {% tr "Pour réactiver la boutique avec toutes ses anciennes données, contactez le gestionnaire de la plateforme avant cette date : un nouvel abonnement peut être activé à tout moment pendant la période de conservation." %}
+                </div>
+                <div class="d-flex justify-content-center gap-2">
+                    <a href="{% url 'core:deconnexion' %}" class="btn btn-outline-secondary">
+                        <i class="bi bi-box-arrow-right me-1"></i> {% tr "Se déconnecter" %}
+                    </a>
+                </div>
+            </div>
+        </div>
+    </div>
+</div>
+{% endblock %}
