# ==============================================================
# Projet_tailleur — variables d'environnement
#
# 1. Copier ce fichier :      cp .env.example .env
# 2. Renseigner les valeurs.
# 3. .env est déjà dans .gitignore : il ne doit JAMAIS être commité.
#
# Toute variable déjà présente dans l'environnement du système a
# priorité sur ce fichier (pratique pour Docker / systemd / PaaS).
# ==============================================================


# --------------------------------------------------------------
# DJANGO
# --------------------------------------------------------------

# Clé secrète. À générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# OBLIGATOIRE en production : l'application refuse de démarrer si
# DEBUG=False et que la clé vaut encore la valeur de développement.
DJANGO_SECRET_KEY=

# True en local, False dès que le site est accessible depuis Internet.
# Avec DEBUG=True, Django affiche la page d'erreur détaillée (source des
# vues, variables locales, settings) : à ne jamais laisser en production.
DJANGO_DEBUG=True

# Noms d'hôte autorisés, séparés par des virgules.
# En production : le ou les domaines réels, ex. app.montailleur.ml,www.montailleur.ml
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# --------------------------------------------------------------
# BASE DE DONNÉES
# --------------------------------------------------------------

# postgresql (défaut) ou sqlite3 pour un démarrage sans serveur PostgreSQL.
DB_ENGINE=postgresql
DB_NAME=tailleur_db
DB_USER=postgres

# ⚠️  Ne laisser aucune valeur par défaut ici.
# Le mot de passe qui était codé en dur dans settings.py a été retiré du
# dépôt : il est considéré comme compromis et doit être changé sur toutes
# les bases où il a servi.
DB_PASSWORD=

DB_HOST=localhost
DB_PORT=5432


# --------------------------------------------------------------
# SÉCURITÉ HTTP (appliqués uniquement quand DJANGO_DEBUG=False)
# --------------------------------------------------------------

# Redirige toutes les requêtes HTTP vers HTTPS.
SECURE_SSL_REDIRECT=True

# Durée HSTS en secondes. 3600 (1 h) pour un premier déploiement,
# puis 31536000 (1 an) une fois le HTTPS validé.
SECURE_HSTS_SECONDS=3600

# N'activer qu'après plusieurs mois de HTTPS fiable : le préchargement
# est difficile à annuler.
SECURE_HSTS_PRELOAD=False

# Décommenter derrière un reverse proxy TLS (nginx, Caddy, Traefik…),
# sinon SECURE_SSL_REDIRECT provoque une boucle de redirections :
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO:https


# --------------------------------------------------------------
# DIVERS
# --------------------------------------------------------------

# Fuseau horaire d'affichage. L'atelier est au Mali ? Africa/Bamako.
# (settings.py utilise UTC par défaut — à changer dans le fichier si besoin.)
# TZ=UTC
