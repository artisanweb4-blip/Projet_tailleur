+  // --- Édition : chargement des données via l'API ---
+  const API_MENS  = "{% url 'core:api_mensurations_client' client.id %}";
+  const AJOUT_URL = form.action;
+  let cacheMens = null;
+  function chargerMensurations() {
+    if (cacheMens) return Promise.resolve(cacheMens);
+    return fetch(API_MENS, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
+      .then(function (r) { return r.json(); })
+      .then(function (d) { cacheMens = d.mensurations || []; return cacheMens; })
+      .catch(function () { return []; });
+  }
+  function viderLignes() {
+    modal.querySelectorAll('.dynamic-row').forEach(function (r) { r.remove(); });
+  }
+  function lignesParDefaut() {
+    modal.querySelectorAll('.dynamic-section').forEach(function (section) {
+      const nb = parseInt(section.dataset.rows || '3', 10);
+      for (let i = 0; i < nb; i++) section.appendChild(creerLigne());
+    });
+  }
+  function reinitialiserModal() {
+    form.action = AJOUT_URL;
+    texteTitreModal.textContent = 'Ajouter des mensurations';
+    form.reset();
+    pourClient.checked = true;
+    btnHomme.checked = true;
+    viderLignes();
+    lignesParDefaut();
+    toggleSections();
+    toggleProche();
+    majCompteurs();
+  }
+
