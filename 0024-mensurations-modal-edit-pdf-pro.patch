-    else pourClient.checked = true;
-    toggleProche();
+    const editId = trigger ? trigger.dataset.editId : null;
+    if (!editId) {
+      const pour = trigger ? trigger.dataset.pour : 'client';
+      if (pour === 'proche') pourProche.checked = true;
+      else pourClient.checked = true;
+      toggleProche();
+      return;
+    }
+    // Mode modification : même formulaire, pré-rempli
+    texteTitreModal.textContent = 'Modifier les mensurations';
+    chargerMensurations().then(function (liste) {
+      const m = liste.find(function (x) { return String(x.id) === String(editId); });
+      if (!m) return;
+      form.action = m.url_edit;
+      if (m.est_proche) pourProche.checked = true; else pourClient.checked = true;
+      toggleProche();
+      inputBeneficiaire.value = m.beneficiaire || '';
+      if (m.lien_code) selectLien.value = m.lien_code;
+      if (m.genre === 'femme') btnFemme.checked = true; else btnHomme.checked = true;
+      toggleSections();
+      inputLibelle.value = m.libelle || '';
+      majSousTitre();
+      viderLignes();
+      const sec = modal.querySelector('#secBase .dynamic-section');
+      const entrees = Object.entries(m.donnees || {});
+      entrees.forEach(function (e) {
+        const ligne = creerLigne();
+        ligne.querySelector('input[name="champ_nom[]"]').value = e[0];
+        ligne.querySelector('input[name="champ_valeur[]"]').value = e[1];
+        sec.appendChild(ligne);
+      });
+      if (!entrees.length) lignesParDefaut();
+      majCompteurs();
+    });
   });
 
